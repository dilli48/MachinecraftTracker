[Unit]
Description=Machinecraft Jacquard Production & Inventory API Server
After=network.target postgresql.service

[Section]
[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/MachinecraftTracker
ExecStart=/home/ubuntu/MachinecraftTracker/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/MachinecraftTracker/.env

[Install]
WantedBy=multi-user.target
